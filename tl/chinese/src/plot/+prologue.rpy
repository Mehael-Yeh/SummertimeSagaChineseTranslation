# game/src/plot/+prologue.rpy:6
translate chinese prologue_29c59866:

    # mono "March 3rd, on a rainy afternoon." with fadewait
    mono "3月3日，一个下雨的下午。" with fadewait

# game/src/plot/+prologue.rpy:7
translate chinese prologue_06aa3467:

    # mono "My father's funeral."
    mono "我父亲的葬礼。"

# game/src/plot/+prologue.rpy:8
translate chinese prologue_aac8090d:

    # mono "I can't believe he's really gone."
    mono "我不敢相信他真的走了。"

# game/src/plot/+prologue.rpy:9
translate chinese prologue_6aabde63:

    # mono "He died from a work related accident at the age of forty-seven, leaving me all alone with no family to speak of..."
    mono "他在四十七岁时死于一起工伤事故，留下我孤身一人，无亲无故……"

# game/src/plot/+prologue.rpy:14
translate chinese prologue_9cffb101:

    # mono "Circumstances surrounding his death have been found \"suspicious\" by the police." with fadewait
    mono "警方认为他死亡的情况「可疑」。" with fadewait

# game/src/plot/+prologue.rpy:15
translate chinese prologue_c131b7fc:

    # mono "They were at our house for an entire week, bombarding me with questions to which I had no answers."
    mono "他们在我家待了整整一周，不停地问我问题，而我一个也答不上来。"

# game/src/plot/+prologue.rpy:16
translate chinese prologue_b18efab7:

    # mono "No conclusive evidence has been found and the knowledge that my father will get no justice weighs heavily upon me."
    mono "没有找到确凿证据，想到父亲无法获得公正，我心情沉重。"

# game/src/plot/+prologue.rpy:19
translate chinese prologue_12c0686b:

    # mono "Luckily, my father's lifelong friend has taken me in and given me a room in her home." with fadewait
    mono "幸运的是，我父亲的终身朋友收留了我，在家里给我安排了一个房间。" with fadewait

# game/src/plot/+prologue.rpy:20
translate chinese prologue_4be39367:

    # mono "She's a kind woman, with a big home, and only her daughter living there with her."
    mono "她是个善良的女人，房子很大，只有她女儿和她住在一起。"

# game/src/plot/+prologue.rpy:26
translate chinese prologue_138c60ac:

    # mono "The night of the funeral, I overheard her reminiscing about my father in the kitchen." with fadewait
    mono "葬礼那天晚上，我无意中听到她在厨房里回忆我父亲。" with fadewait

# game/src/plot/+prologue.rpy:27
translate chinese prologue_065ab169:

    # mono "She eventually broke down and said she didn't know what to do."
    mono "她终于崩溃了，说她不知道该怎么办。"

# game/src/plot/+prologue.rpy:28
translate chinese prologue_d8d55bdc:

    # mono "It seems my father had gotten involved with some really bad people who were now pressuring her to cover his debts."
    mono "似乎我父亲招惹了一些非常糟糕的人，现在他们正在逼她偿还他的债务。"

# game/src/plot/+prologue.rpy:35
translate chinese prologue_244739f4:

    # mono ""
    mono ""

# game/src/plot/+prologue.rpy:41
translate chinese prologue_cd289727:

    # mono "Now, a month later, things are finally starting to settle down." with dissolve
    mono "现在，一个月过去了，事情终于开始稳定下来。" with dissolve

# game/src/plot/+prologue.rpy:42
translate chinese prologue_a6160fa0:

    # mono "I've gotten used to the new living arrangements, and today will be my first day back at college."
    mono "我已经习惯了新的生活安排，今天是我回大学的第一天。"

# game/src/plot/+prologue.rpy:43
translate chinese prologue_02d33f33:

    # mono "It'll be nice to see my friends again."
    mono "又能见到朋友们了，真好。"

# game/src/plot/+prologue.rpy:44
translate chinese prologue_f6ea1d19:

    # mono "There are three things I have to take care of before the end of the semester."
    mono "在学期结束前，我有三件事必须完成。"

# game/src/plot/+prologue.rpy:45
translate chinese prologue_48aae4b7:

    # mono "1) I need to earn some money and help pay off my father's debts."
    mono "1) 我需要挣些钱，帮助偿还父亲的债务。"

# game/src/plot/+prologue.rpy:46
translate chinese prologue_38c09a3d:

    # more "2) I have to uncover the truth about my father's death."
    more "2) 我必须查明父亲死亡的真相。"

# game/src/plot/+prologue.rpy:47
translate chinese prologue_02929702:

    # more "3) I have to find a date for the Sorority Ball."
    more "3) 我必须为姐妹会舞会找个约会对象。"

